# Generated by scripts/release-modpack.mjs — do not edit by hand.

AddType application/x-modrinth-modpack+zip .mrpack

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^latest\.mrpack$ /downloads/progression-survival/releases/1.0.0-rc.6/Progression-Survival-1.0.0-rc.6.mrpack [R=302,L]
	RewriteRule ^latest-server\.zip$ /downloads/progression-survival/releases/1.0.0-rc.6/Progression-Survival-Server-1.0.0-rc.6.zip [R=302,L]
</IfModule>

<IfModule mod_headers.c>
	# The pointers must be re-checked on every request, or a cache in front of
	# the site keeps handing out the previous release after a deploy.
	<FilesMatch "\.json$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	Header always set Cache-Control "no-store" "expr=%{REQUEST_URI} =~ m#/latest(-server)?\.(mrpack|zip)$#"

	# Archives download rather than open, under their versioned name.
	<FilesMatch "\.(mrpack|zip)$">
		Header set Content-Disposition attachment
	</FilesMatch>
</IfModule>
